<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinalYearProject.AdminPage"
             Title="Admin Page">

    <ContentPage.Resources>
        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="MinimumHeightRequest" Value="40" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid BackgroundColor="{StaticResource Background}">
        <VerticalStackLayout Padding="20" Spacing="14" MaximumWidthRequest="860" HorizontalOptions="Center">
            <Border Style="{StaticResource HeroBanner}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Manage users" FontFamily="PoppinsSemiBold" FontSize="24" TextColor="White" />
                    <Label Text="Accounts stored on this device. Tap a user for details." TextColor="White" FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <CollectionView x:Name="UserCollectionView"
                            SelectionMode="Single"
                            SelectionChanged="OnUserSelected">
                <CollectionView.EmptyView>
                    <Label Text="No users found." Style="{StaticResource Caption}" HorizontalOptions="Center" Margin="0,24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Username}" Style="{StaticResource SectionTitle}" />
                                    <Label Text="{Binding Email}" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="Delete" Clicked="OnDeleteUserClicked" Style="{StaticResource DeleteButtonStyle}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>