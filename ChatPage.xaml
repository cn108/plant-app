<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinalYearProject.ChatPage"
             Title="Live Chat Support">
    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="20" MaximumWidthRequest="720">
            <Border Style="{StaticResource HeroBanner}">
                <Label Text="Live chat support" FontSize="28" FontAttributes="Bold" TextColor="White" />
            </Border>

            <Border Style="{StaticResource Card}">
                <Label x:Name="chatMessages" FontSize="16" />
            </Border>

            <Entry x:Name="MessageEntry"
                   Placeholder="Type your message..."
                   FontSize="16"
                   BackgroundColor="White" />

            <Button x:Name="sendButton"
                    Text="Send"
                    Clicked="OnSendClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>