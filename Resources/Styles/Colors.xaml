<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- The only five greens used in the app, darkest to lightest -->
    <Color x:Key="Green1">#0D381E</Color>
    <Color x:Key="Green2">#164F2C</Color>
    <Color x:Key="Green3">#1F693C</Color>
    <Color x:Key="Green4">#2A834D</Color>
    <Color x:Key="Green5">#349E5E</Color>

    <Color x:Key="Primary">#1F693C</Color>
    <Color x:Key="PrimaryDark">#164F2C</Color>
    <Color x:Key="PrimaryLight">#FFFFFF</Color>
    <Color x:Key="Secondary">#349E5E</Color>
    <Color x:Key="TextColor">#1E2420</Color>
    <Color x:Key="White">#FFFFFF</Color>
</ResourceDictionary>
