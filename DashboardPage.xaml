<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:FinalYearProject"
             x:Class="FinalYearProject.DashboardPage"
             Title="Dashboard">
    <ContentPage.BindingContext>
        <viewModels:DashboardViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="20" MaximumWidthRequest="820">

            <Border Style="{StaticResource HeroBanner}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Your garden" FontSize="28" FontAttributes="Bold" TextColor="White" />
                    <Label Text="{Binding WeatherMessage}" TextColor="White" />
                    <ActivityIndicator IsRunning="{Binding IsFetchingWeather}"
                                       IsVisible="{Binding IsFetchingWeather}"
                                       Color="White" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <SearchBar Placeholder="Search plants" Text="{Binding SearchQuery}"
                       SearchCommand="{Binding SearchCommand}" />

            <CollectionView ItemsSource="{Binding FilteredPlants}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding PlantName}" FontAttributes="Bold" />
                                <Label Text="{Binding Season}" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Button Text="Fruits" Command="{Binding NavigateToFruitsCommand}"
                        Style="{StaticResource SecondaryButton}" />
                <Button Grid.Column="1" Text="Vegetables" Command="{Binding NavigateToVegetablesCommand}"
                        Style="{StaticResource SecondaryButton}" />
                <Button Grid.Column="2" Text="Add plant" Command="{Binding AddPlantCommand}" />
            </Grid>

            <Label Text="Upcoming care" Style="{StaticResource SectionTitle}" />
            <CollectionView ItemsSource="{Binding CareTasks}">
                <CollectionView.EmptyView>
                    <Label Text="No care tasks yet. Add a plant to get a care schedule."
                           Style="{StaticResource Caption}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding PlantName}" FontAttributes="Bold" />
                                    <Label Text="{Binding TaskDescription}" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" VerticalOptions="Center"
                                       Text="{Binding TaskDate, StringFormat='{0:dd MMM}'}"
                                       TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Reminders" Style="{StaticResource SectionTitle}" />
            <CollectionView ItemsSource="{Binding Reminders}">
                <CollectionView.EmptyView>
                    <Label Text="You're all caught up." Style="{StaticResource Caption}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label Text="{Binding TaskDescription}" VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="Done"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:DashboardViewModel}}, Path=MarkAsDoneCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="View detailed weather" Command="{Binding NavigateToWeatherCommand}"
                    Style="{StaticResource SecondaryButton}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
