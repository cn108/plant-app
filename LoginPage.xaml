<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinalYearProject.LoginPage"
             Title="Sign in">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#164F2C" Offset="0.0" />
            <GradientStop Color="#2A834D" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <Border Style="{StaticResource Card}" Padding="28" Margin="20"
                MaximumWidthRequest="440" VerticalOptions="Center" HorizontalOptions="Center">
            <VerticalStackLayout Spacing="14">
                <Label Text="Welcome back" Style="{StaticResource PageTitle}" />
                <Label Text="Sign in to manage your plants and care schedule." Style="{StaticResource Caption}" />

                <Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email"
                       SemanticProperties.Description="Email address" />
                <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True"
                       SemanticProperties.Description="Password" />

                <Button Text="Sign in" Clicked="OnLoginClicked" Margin="0,8,0,0" />
                <Button Text="Create an account" Clicked="OnRegisterClicked"
                        Style="{StaticResource SecondaryButton}" />
            </VerticalStackLayout>
        </Border>
    </ScrollView>
</ContentPage>
