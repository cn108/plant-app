<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinalYearProject.MessagesPage"
             Title="Forum messages">
    <Grid RowDefinitions="Auto,*" Padding="20" RowSpacing="16">
        <Border Style="{StaticResource HeroBanner}">
            <VerticalStackLayout Spacing="4">
                <Label Text="Community feed" FontSize="28" FontAttributes="Bold" TextColor="White" />
                <Label x:Name="SourceLabel" TextColor="White" />
            </VerticalStackLayout>
        </Border>

        <RefreshView Grid.Row="1" x:Name="Refresher" Refreshing="OnRefreshing">
            <CollectionView x:Name="PostsView">
                <CollectionView.EmptyView>
                    <Label Text="No posts yet. Start the conversation from the Forum page."
                           HorizontalOptions="Center" Margin="0,40" TextColor="{StaticResource Muted}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Username}" FontAttributes="Bold" FontSize="18" TextColor="{StaticResource Green2}" />
                                    <Label Grid.Column="1" Text="{Binding Category}" TextColor="{StaticResource Green3}" FontAttributes="Bold" />
                                </Grid>
                                <Label Text="{Binding Text}" FontSize="16" />
                                <Label Text="{Binding CreatedAt, StringFormat='{0:dd MMM yyyy HH:mm}'}" FontSize="12" TextColor="{StaticResource Muted}" />
                                <Label Text="{Binding LatestReply}" IsVisible="{Binding HasReplies}" TextColor="{StaticResource Muted}" />
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding ReplySummary}" VerticalOptions="Center" TextColor="{StaticResource Muted}" />
                                    <Button Grid.Column="1" Text="Reply" Style="{StaticResource SecondaryButton}" Clicked="OnReplyClicked" />
                                    <Button Grid.Column="2" Text="Report" Style="{StaticResource SecondaryButton}" Clicked="OnReportClicked" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
