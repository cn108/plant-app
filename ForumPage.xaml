<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinalYearProject.ForumPage"
             Title="Community Forum">
    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="20" MaximumWidthRequest="720" HorizontalOptions="Center">
            <Border Style="{StaticResource HeroBanner}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Community forum" FontSize="28" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Ask questions and share growing tips with other gardeners." TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="New post" Style="{StaticResource SectionTitle}" />
                    <Picker x:Name="CategoryPicker" Title="Select category" TextColor="{StaticResource TextColor}">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Planting Season</x:String>
                                <x:String>Best Soil Type</x:String>
                                <x:String>Best Fertilizer</x:String>
                                <x:String>General Discussion</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                    <Entry x:Name="MessageEntry" Placeholder="Share something with the community" />
                    <Label x:Name="StatusLabel" TextColor="{StaticResource Danger}" />
                    <Button Text="Post message" Clicked="OnSendMessageClicked" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Browse messages" Clicked="OnViewMessagesClicked"
                    Style="{StaticResource SecondaryButton}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
