<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinalYearProject.AdminLoginPage"
             Title="Admin Login">
    <ContentPage.Resources>
        <Style x:Key="HeaderLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="36" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid BackgroundColor="{StaticResource Green1}">
        <StackLayout Padding="30" Spacing="20" VerticalOptions="Center">
            <Label Text="Admin Login" Style="{StaticResource HeaderLabelStyle}" />

            <Label Text="Admin sign-in is unavailable until secure server-side authentication is configured."
                   TextColor="White"
                   HorizontalTextAlignment="Center" />
        </StackLayout>
    </Grid>
</ContentPage>
