<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:FinalYearProject"
             x:Class="FinalYearProject.AddPlantPage"
             Title="Add Plant">

    <ContentPage.BindingContext>
        <viewModels:AddPlantViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="20" MaximumWidthRequest="640" HorizontalOptions="Center">
            <Border Style="{StaticResource HeroBanner}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Add a plant" FontSize="28" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Save a plant to track watering and care." TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Entry Placeholder="Plant name (try Tomatoes or Apple)" Text="{Binding PlantName}" />
                    <Label Text="{Binding Suggestion}" Style="{StaticResource Caption}" />
                    <Entry Placeholder="Season (e.g. Spring)" Text="{Binding Season}" />
                    <Entry Placeholder="Water per watering (litres)" Text="{Binding WaterPerLiters}" Keyboard="Numeric" />
                    <Entry Placeholder="Water every how many days?" Text="{Binding WateringIntervalDays}" Keyboard="Numeric" />

                    <Border StrokeShape="RoundRectangle 14" Stroke="{StaticResource Outline}"
                            BackgroundColor="{StaticResource PrimaryLight}" HeightRequest="180">
                        <Grid>
                            <Label Text="No photo yet" Style="{StaticResource Caption}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            <Image Source="{Binding PlantImage}" Aspect="AspectFill" />
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Text="Choose photo" Command="{Binding UploadImageCommand}"
                                Style="{StaticResource SecondaryButton}" />
                        <Button Grid.Column="1" Text="Take photo" Command="{Binding CaptureImageCommand}"
                                Style="{StaticResource SecondaryButton}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Save plant" Command="{Binding SavePlantCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
