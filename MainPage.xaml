<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinalYearProject.MainPage"
             Title="Scan a Plant">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="20" MaximumWidthRequest="720">
            <Border Style="{StaticResource HeroBanner}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Scan a plant" FontSize="28" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Take or choose a clear photo of a leaf or flower and we will suggest what it is."
                           TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Padding="8">
                <Grid HeightRequest="320">
                    <Image Source="{Binding Photo}" Aspect="AspectFit" />
                    <Label Text="Your photo will appear here"
                           Style="{StaticResource Caption}"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           IsVisible="{Binding Photo, Converter={StaticResource NullToBooleanConverter}, ConverterParameter=invert}" />
                    <ActivityIndicator IsRunning="{Binding IsRunning}" IsVisible="{Binding IsRunning}"
                                       Color="{StaticResource Primary}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <Label Text="{Binding OutputLabel}" FontSize="16" LineHeight="1.3"
                       SemanticProperties.Description="Identification result" />
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Choose photo" Command="{Binding PickPhotoCommand}"
                        Style="{StaticResource SecondaryButton}" />
                <Button Grid.Column="1" Text="Take photo" Command="{Binding TakePhotoCommand}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
